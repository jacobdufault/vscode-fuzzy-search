{
  "name": "fuzzy-search-plus",
  "displayName": "Fuzzy Search Plus",
  "description": "Fuzzy search the current file, its diagnostics, git changes and git-tracked files from the quick pick.",
  "author": "Virgil Sisoe",
  "license": "MIT",
  "version": "1.0.0",
  "publisher": "virgilsisoe",
  "engines": {
    "vscode": "^1.88.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "fuzzy",
    "search",
    "lines",
    "git",
    "diagnostics",
    "quick pick"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "homepage": "https://github.com/sisoe24/vscode-fuzzy-search",
  "repository": {
    "type": "git",
    "url": "https://github.com/sisoe24/vscode-fuzzy-search.git"
  },
  "bugs": {
    "url": "https://github.com/sisoe24/vscode-fuzzy-search/issues"
  },
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "title": "Fuzzy lines",
        "category": "Search",
        "command": "fuzzySearch.activeTextEditor"
      },
      {
        "title": "Fuzzy lines with current selection",
        "category": "Search",
        "command": "fuzzySearch.activeTextEditorWithCurrentSelection"
      },
      {
        "title": "Fuzzy diagnostics",
        "category": "Search",
        "command": "fuzzySearch.activeTextEditorDiagnostics"
      },
      {
        "title": "Fuzzy git status",
        "category": "Search",
        "command": "fuzzySearch.gitStatus"
      },
      {
        "title": "Fuzzy git changes",
        "category": "Search",
        "command": "fuzzySearch.gitChanges"
      },
      {
        "title": "Fuzzy git files",
        "category": "Search",
        "command": "fuzzySearch.gitFiles"
      },
      {
        "title": "Fuzzy git files text",
        "category": "Search",
        "command": "fuzzySearch.gitFilesText"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/vscode": "^1.88.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
